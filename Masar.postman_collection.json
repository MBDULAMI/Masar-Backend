{
  "info": {
    "name": "Masar API — Happy Path + Failure Paths",
    "description": "Covers: register/login, trip search, successful booking, and three required failure paths — sold-out trip, insufficient balance, another passenger's booking (R8). Uses the app's seeded accounts. Run requests top to bottom within each folder (and folders 1 -> 2 -> 3 -> 4 in order, since folder 4 depends on a booking created in folder 1); some requests use variables captured by the preceding request's Tests script. Assumes a freshly started app (fresh H2 instance) so seeded IDs are in their default order — passenger2's account id is 6, per DataSeeder's insertion order (admin, 3 operator-owner accounts, then 3 passengers).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "passengerToken", "value": "" },
    { "key": "otherPassengerToken", "value": "" },
    { "key": "lowBalanceToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "operatorToken", "value": "" },
    { "key": "tripId", "value": "" },
    { "key": "smallTripId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Happy Path",
      "item": [
        {
          "name": "Login as passenger1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger1@masar.com\",\n  \"password\": \"passenger123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('passengerToken', json.token);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search trips",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/trips?page=0&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.content && json.content.length > 0) {",
                  "  pm.collectionVariables.set('tripId', json.content[0].id);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create booking (happy path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{passengerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": {{tripId}},\n  \"seatCount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', json.id);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Booking is CONFIRMED', () => pm.expect(json.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "View own booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{passengerToken}}" }],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Failure — Sold-out trip",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@masar.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as operator1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner1@masar.com\",\n  \"password\": \"operator123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('operatorToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish a 1-seat trip",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originCity\": \"Riyadh\",\n  \"destinationCity\": \"Jeddah\",\n  \"departureTime\": \"2026-09-01T09:00:00+03:00\",\n  \"arrivalTime\": \"2026-09-01T19:00:00+03:00\",\n  \"busCode\": \"BUS-SOLDOUT\",\n  \"totalSeats\": 1,\n  \"seatPrice\": 50.00\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('smallTripId', json.id);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top up passenger2 wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/wallet/topup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": 6,\n  \"amount\": 200.00\n}"
            }
          }
        },
        {
          "name": "Login as passenger2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger2@masar.com\",\n  \"password\": \"passenger123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('otherPassengerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book the only seat (fills the trip)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherPassengerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": {{smallTripId}},\n  \"seatCount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "FAILURE — Try to book the sold-out trip",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{passengerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": {{smallTripId}},\n  \"seatCount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict (sold out)', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Failure — Insufficient balance",
      "item": [
        {
          "name": "Login as passenger3 (low balance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger3@masar.com\",\n  \"password\": \"passenger123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('lowBalanceToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search trips",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/trips?page=0&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.content && json.content.length > 0) {",
                  "  pm.collectionVariables.set('tripId', json.content[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "FAILURE — Book 4 seats (150/seat, balance only 100)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{lowBalanceToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": {{tripId}},\n  \"seatCount\": 4\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422 Unprocessable Entity (insufficient balance)', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Failure — Another passenger's booking (R8)",
      "item": [
        {
          "name": "Login as passenger2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger2@masar.com\",\n  \"password\": \"passenger123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('otherPassengerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "FAILURE — passenger2 tries to view passenger1's booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherPassengerToken}}" }],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 (ownership hidden, not 403)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "FAILURE — passenger2 tries to cancel passenger1's booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherPassengerToken}}" }],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 (ownership hidden, not 403)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
